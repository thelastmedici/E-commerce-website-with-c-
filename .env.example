# Copy to .env for local compose use. Never commit real values.
MSSQL_SA_PASSWORD=replace-with-a-strong-sql-password
JWT_KEY=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGIN=https://app.example.com
DOMAIN=api.example.com

# Set these only for the first application startup to create an admin.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
